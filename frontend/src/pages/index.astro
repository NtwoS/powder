---
// index.astro
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Powder AI - Interface</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="/src/styles/index.css" />
	</head>
	<body>
		<div class="app-wrapper">
			<!-- Sidebar -->
			<aside class="sidebar">
				<div class="sidebar-header">
					<div class="logo">
						<span class="dot"></span>
						<h1>Powder AI</h1>
					</div>
				</div>

				<nav class="sidebar-nav">
					<button class="nav-item active" id="btn-new-chat">
						<div class="nav-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></div>
						<span>New Chat</span>
					</button>
					<button class="nav-item" id="btn-skills">
						<div class="nav-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg></div>
						<span>Skill & Tugas</span>
					</button>
					<button class="nav-item" id="btn-admin-panel">
						<div class="nav-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2-2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></div>
						<span>Otak Powder</span>
					</button>
					<button class="nav-item" id="btn-settings">
						<div class="nav-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg></div>
						<span>Settings</span>
					</button>
				</nav>

				<div class="sidebar-footer">
					<div class="user-profile">
						<div class="avatar">U</div>
						<div class="user-info">
							<span id="display-user-name">Pengguna</span>
							<span id="connection-status" class="offline">Offline</span>
						</div>
					</div>
				</div>
			</aside>

			<!-- Main Chat -->
			<main class="chat-area" id="view-chat">
				<div id="chat-container">
					<div class="message system">
						<p>Selamat datang! Saya Powder, asisten virtual Anda.</p>
					</div>
				</div>

				<footer class="chat-footer">
					<form id="chat-form">
						<input type="file" id="file-analyzer" accept=".txt,.pdf" style="display: none;" />
						<button type="button" class="btn-icon" id="btn-attach" title="Analisis File (.txt, .pdf)">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
						</button>
						<input type="text" id="user-input" placeholder="Tanya sesuatu atau unggah file untuk dianalisis..." autocomplete="off" />
						<button type="submit">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
						</button>
					</form>
				</footer>
			</main>

			<!-- Admin Panel -->
			<main class="chat-area" id="view-admin" style="display: none;">
				<div class="admin-header">
					<div class="header-main">
						<h2>Manajemen Otak Powder</h2>
						<p>Lihat dan kelola semua pola pengetahuan yang sudah dipelajari.</p>
					</div>
					<div class="header-actions">
						<div class="search-box">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
							<input type="text" id="admin-search" placeholder="Cari pengetahuan..." />
						</div>
						<input type="file" id="csv-upload" accept=".csv" style="display: none;" />
						<button class="btn-secondary" id="btn-trigger-upload">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
							Impor CSV
						</button>
					</div>
				</div>
				<div class="admin-table-container">
					<table id="admin-table">
						<thead>
							<tr>
								<th>Pola (Pemicu)</th>
								<th>Variasi Respon</th>
								<th>Aksi</th>
							</tr>
						</thead>
						<tbody id="admin-table-body">
							<!-- Data akan dimuat di sini -->
						</tbody>
					</table>
				</div>
			</main>

			<!-- Skills & Tugas Panel -->
			<main class="chat-area" id="view-skills" style="display: none;">
				<div class="admin-header">
					<h2>Skill & Tugas Powder</h2>
					<p>Pilih keahlian atau tugas yang ingin Powder kerjakan sekarang.</p>
				</div>
				
				<div class="settings-container">
					<div class="personality-grid">
						<!-- Card Latihan -->
						<div class="job-card clickable-card" id="card-skill-latihan">
							<div class="p-icon">🎓</div>
							<h4>Mode Latihan</h4>
							<p>Ajarkan Powder pola respon baru secara langsung melalui chat.</p>
							<div class="status-badge">Aktifkan</div>
						</div>

						<!-- Card Keuangan -->
						<div class="job-card clickable-card" id="card-skill-finance">
							<div class="p-icon">💰</div>
							<h4>Manajemen Keuangan</h4>
							<p>Catat pengeluaran, pemasukan, dan biarkan Powder menghitung saldo Anda.</p>
							<div class="status-badge" style="background: #10b981;">Buka Kalkulator</div>
						</div>

						<!-- Placeholder -->
						<div class="job-card" style="opacity: 0.5; cursor: default;">
							<div class="p-icon">➕</div>
							<h4>Coming Soon</h4>
							<p>Keahlian baru akan segera ditambahkan.</p>
						</div>
					</div>
				</div>
			</main>

			<!-- Settings Panel -->
			<main class="chat-area" id="view-settings" style="display: none;">
				<div class="admin-header">
					<h2>Pengaturan Powder</h2>
					<p>Sesuaikan memori dan kepribadian asisten virtual Anda.</p>
				</div>
				
				<div class="settings-container">
					<!-- Card Utama 1: Riwayat -->
					<div class="settings-card" id="card-main-history">
						<div class="card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
						<div class="card-content">
							<h3>Pengaturan Riwayat</h3>
							<p>Kelola berapa lama Powder menyimpan ingatan percakapan Anda.</p>
							<div class="input-group">
								<input type="number" id="input-history-days" value="7" min="1" max="365" />
								<span>Hari</span>
								<button class="btn-save" id="btn-save-history">Simpan</button>
							</div>
						</div>
					</div>

					<!-- Card Utama 2: Kepribadian (Trigger) -->
					<div class="settings-card clickable-card" id="btn-show-personality">
						<div class="card-icon">🎭</div>
						<div class="card-content">
							<h3>Kepribadian Powder</h3>
							<p>Ubah gaya bicara Powder menjadi lebih Ceria, Santai, atau Profesional.</p>
							<span class="status-badge" id="current-personality-badge">Ceria</span>
						</div>
						<div class="card-arrow">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
						</div>
					</div>

					<!-- Personality Sub-Menu (Hidden by default) -->
					<div class="personality-section" id="personality-sub-menu" style="display: none;">
						<div class="section-header">
							<button class="btn-back" id="btn-back-settings">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
								Kembali
							</button>
							<h3>Pilih Gaya Bicara</h3>
						</div>
						<div class="personality-grid">
							<div class="personality-card" data-personality="ceria">
								<div class="p-icon">✨</div>
								<h4>Ceria</h4>
								<p>Ramah, penuh energi, dan suka menggunakan emoji.</p>
							</div>
							<div class="personality-card" data-personality="profesional">
								<div class="p-icon">💼</div>
								<h4>Profesional</h4>
								<p>Serius, formal, dan memberikan jawaban yang padat.</p>
							</div>
							<div class="personality-card" data-personality="santai">
								<div class="p-icon">😎</div>
								<h4>Santai</h4>
								<p>Gaya bicara asik, santai, dan seperti teman akrab.</p>
							</div>
						</div>
					</div>
				</div>
			</main>
		</div>



		<script>
			const form = document.getElementById('chat-form');
			const input = document.getElementById('user-input');
			const container = document.getElementById('chat-container');
			const status = document.getElementById('connection-status');
			const userNameDisplay = document.getElementById('display-user-name');
			
			// Sidebar Buttons
			const btnSkills = document.getElementById('btn-skills');
			const btnNewChat = document.getElementById('btn-new-chat');
			const btnAdminPanel = document.getElementById('btn-admin-panel');
			const btnSettings = document.getElementById('btn-settings');
			
			// Views
			const viewChat = document.getElementById('view-chat');
			const viewSkills = document.getElementById('view-skills');
			const viewAdmin = document.getElementById('view-admin');
			const viewSettings = document.getElementById('view-settings');

			// State Machine for Training Mode
			let currentMode = 'chat'; // 'chat' or 'train'
			let trainingState = 'idle'; // 'idle', 'trigger', 'response'
			let tempTrigger = '';

			function showView(viewName) {
				const views = {
					'chat': viewChat,
					'skills': viewSkills,
					'admin': viewAdmin,
					'settings': viewSettings
				};
				const navs = {
					'chat': btnNewChat,
					'skills': btnSkills,
					'admin': btnAdminPanel,
					'settings': btnSettings
				};

				// Sembunyikan semua view dan hapus class active di semua tombol
				Object.values(views).forEach(v => { if(v) v.style.display = 'none'; });
				Object.values(navs).forEach(n => { if(n) n.classList.remove('active'); });

				// Tampilkan view yang dipilih dan aktifkan tombolnya
				if (views[viewName]) {
					views[viewName].style.display = 'flex';
				}
				if (navs[viewName]) {
					navs[viewName].classList.add('active');
				}

				if (viewName === 'admin') fetchIntents();
				if (viewName === 'settings') fetchSettings();
			}

			// Sidebar Navigation Listeners
			btnNewChat.addEventListener('click', () => showView('chat'));
			btnSkills.addEventListener('click', () => showView('skills'));
			btnAdminPanel.addEventListener('click', () => showView('admin'));
			btnSettings.addEventListener('click', () => showView('settings'));

			// Skills Card Actions
			document.getElementById('card-skill-latihan').addEventListener('click', () => {
				showView('chat');
				currentMode = 'train';
				trainingState = 'trigger';
				addMessage("Mode Latihan Aktif. Apa pertanyaan atau pemicu yang ingin Anda ajarkan?", 'bot');
			});

			document.getElementById('card-skill-finance').addEventListener('click', () => {
				showView('chat');
				addMessage("Mode Keuangan Aktif. Silakan sebutkan pengeluaran atau pemasukan Anda (Contoh: 'beli kopi 20rb' atau 'gaji masuk 5jt').", 'bot');
			});

			// Settings Logic
			async function fetchSettings() {
				// Kita butuh endpoint baru atau bisa ambil dari /status jika kita update
				// Untuk sementara kita biarkan user klik kartu untuk mengaktifkan
				// Di dunia nyata, kita fetch dari DB dulu mana yang aktif
			}

			// NAVIGATION CARDS LOGIC
			const btnShowPersonality = document.getElementById('btn-show-personality');
			const btnBackSettings = document.getElementById('btn-back-settings');
			const personalitySubMenu = document.getElementById('personality-sub-menu');
			const cardMainHistory = document.getElementById('card-main-history');

			btnShowPersonality.addEventListener('click', () => {
				// Hide main cards, show sub-menu
				cardMainHistory.style.display = 'none';
				btnShowPersonality.style.display = 'none';
				personalitySubMenu.style.display = 'block';
			});

			btnBackSettings.addEventListener('click', () => {
				// Show main cards, hide sub-menu
				cardMainHistory.style.display = 'flex';
				btnShowPersonality.style.display = 'flex';
				personalitySubMenu.style.display = 'none';
			});

			// Personality Logic (Update Badge)
			const badge = document.getElementById('current-personality-badge');
			document.querySelectorAll('.personality-card').forEach(card => {
				card.addEventListener('click', async () => {
					const p = card.getAttribute('data-personality');
					try {
						const res = await fetch('http://127.0.0.1:5000/settings', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ personality: p })
						});
						if (res.ok) {
							document.querySelectorAll('.personality-card').forEach(c => c.classList.remove('active'));
							card.classList.add('active');
							badge.textContent = p.charAt(0).toUpperCase() + p.slice(1);
						}
					} catch (err) {
						alert("Gagal mengubah kepribadian.");
					}
				});
			});

			// Save History Days
			document.getElementById('btn-save-history').addEventListener('click', async () => {
				const days = document.getElementById('input-history-days').value;
				try {
					const res = await fetch('http://127.0.0.1:5000/settings', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ history_days: parseInt(days) })
					});
					const data = await res.json();
					alert(data.message);
				} catch (err) {
					alert("Gagal menyimpan riwayat.");
				}
			});

			// Admin Logic
			let allIntents = [];
			const adminSearch = document.getElementById('admin-search');

			async function fetchIntents() {
				const tbody = document.getElementById('admin-table-body');
				tbody.innerHTML = '<tr><td colspan="3">Memuat data...</td></tr>';
				
				try {
					const res = await fetch('http://127.0.0.1:5000/intents');
					const data = await res.json();
					allIntents = data.intents;
					renderTable(allIntents);
				} catch (err) {
					tbody.innerHTML = '<tr><td colspan="3">Gagal memuat data pengetahuan.</td></tr>';
				}
			}

			function renderTable(intents) {
				const tbody = document.getElementById('admin-table-body');
				tbody.innerHTML = '';
				
				if (intents.length === 0) {
					tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; color: var(--text-dim);">Data tidak ditemukan.</td></tr>';
					return;
				}

				intents.forEach(item => {
					const tr = document.createElement('tr');
					const responsesHtml = item.responses.map(r => `<span>${r}</span>`).join('');
					
					tr.innerHTML = `
						<td style="font-family: monospace; color: #818cf8;">${item.pattern}</td>
						<td><div class="responses-list">${responsesHtml}</div></td>
						<td style="text-align: center;">
							<button class="btn-delete" data-pattern='${item.pattern}' title="Hapus">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
							</button>
						</td>
					`;
					tbody.appendChild(tr);
				});

				// Add event listeners to delete buttons
				document.querySelectorAll('.btn-delete').forEach(btn => {
					btn.addEventListener('click', () => deleteIntent(btn.getAttribute('data-pattern')));
				});
			}

			// Filter Logic
			adminSearch.addEventListener('input', (e) => {
				const term = e.target.value.toLowerCase();
				const filtered = allIntents.filter(item => 
					item.pattern.toLowerCase().includes(term) || 
					item.responses.some(r => r.toLowerCase().includes(term))
				);
				renderTable(filtered);
			});

			async function deleteIntent(pattern) {
				if (!confirm(`Hapus pengetahuan untuk pola: ${pattern}?`)) return;
				
				try {
					const res = await fetch('http://127.0.0.1:5000/intents/delete', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ pattern })
					});
					const data = await res.json();
					if (data.success) {
						fetchIntents(); // Refresh tabel
					}
				} catch (err) {
					alert("Gagal menghapus data.");
				}
			}

			// New Chat Cleanup Logic
			btnNewChat.addEventListener('click', () => {
				currentMode = 'chat';
				trainingState = 'idle';
				container.innerHTML = `
					<div class="message system">
						<p>Percakapan baru dimulai. Ada yang bisa saya bantu?</p>
					</div>
				`;
			});

			// CSV Upload Logic
			const btnTriggerUpload = document.getElementById('btn-trigger-upload');
			const csvUploadInput = document.getElementById('csv-upload');

			btnTriggerUpload.addEventListener('click', () => csvUploadInput.click());

			csvUploadInput.addEventListener('change', async (e) => {
				const file = e.target.files[0];
				if (!file) return;

				const formData = new FormData();
				formData.append('file', file);

				try {
					btnTriggerUpload.textContent = "Mengunggah...";
					btnTriggerUpload.disabled = true;

					const res = await fetch('http://127.0.0.1:5000/intents/upload', {
						method: 'POST',
						body: formData
					});
					const data = await res.json();
					
					if (data.success) {
						alert(data.message);
						fetchIntents(); // Refresh tabel
					} else {
						alert("Gagal: " + data.message);
					}
				} catch (err) {
					alert("Terjadi kesalahan saat mengunggah file.");
				} finally {
					btnTriggerUpload.innerHTML = `
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
						Impor CSV
					`;
					btnTriggerUpload.disabled = false;
					csvUploadInput.value = ''; // Reset input
				}
			});


			// Check connection & get profile
			async function checkStatus() {
				try {
					const res = await fetch('http://127.0.0.1:5000/status');
					if (res.ok) {
						status.textContent = 'Online';
						status.className = 'online';
					} else {
						throw new Error();
					}
				} catch (e) {
					status.textContent = 'Offline';
					status.className = 'offline';
				}
			}

			// Load Chat History from Database
			async function loadHistory() {
				try {
					const res = await fetch('http://127.0.0.1:5000/history');
					const data = await res.json();
					if (data.history && data.history.length > 0) {
						// Bersihkan container dulu tapi sisihkan pesan selamat datang
						container.innerHTML = '';
						data.history.forEach(chat => {
							addMessage(chat.message, chat.sender);
						});
						addMessage("--- Riwayat Chat Dimuat ---", "system");
					}
				} catch (err) {
					console.error("Gagal memuat history:", err);
				}
			}


			checkStatus();
			loadHistory(); // Panggil history saat startup
			setInterval(checkStatus, 5000);

			// File Analysis Logic
			const btnAttach = document.getElementById('btn-attach');
			const fileAnalyzerInput = document.getElementById('file-analyzer');

			btnAttach.addEventListener('click', () => fileAnalyzerInput.click());

			fileAnalyzerInput.addEventListener('change', async (e) => {
				const file = e.target.files[0];
				if (!file) return;

				addMessage(`Sedang menganalisis file: ${file.name}...`, 'system');

				const formData = new FormData();
				formData.append('file', file);

				try {
					const res = await fetch('http://127.0.0.1:5000/analyze', {
						method: 'POST',
						body: formData
					});
					const data = await res.json();
					
					if (data.success) {
						// Tampilkan hasil analisis dengan format rapi
						const formattedText = data.analysis.replace(/\n/g, '<br>');
						addMessage(formattedText, 'bot');
					} else {
						addMessage("Gagal menganalisis: " + data.message, 'bot');
					}
				} catch (err) {
					addMessage("Terjadi kesalahan koneksi saat menganalisis file.", 'bot');
				} finally {
					fileAnalyzerInput.value = ''; // Reset
				}
			});

			function addMessage(text, sender) {
				const div = document.createElement('div');
				div.className = `message ${sender}`;
				div.innerHTML = `<p>${text}</p>`;
				container.appendChild(div);
				container.scrollTop = container.scrollHeight;
			}

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const msg = input.value.trim();
				if (!msg) return;

				addMessage(msg, 'user');
				input.value = '';

				if (currentMode === 'train') {
					handleTrainingFlow(msg);
				} else {
					handleNormalChat(msg);
				}
			});

			async function handleNormalChat(msg) {
				try {
					const res = await fetch('http://127.0.0.1:5000/chat', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ message: msg })
					});
					const data = await res.json();
					addMessage(data.response, 'bot');
					
					if (data.user_name) {
						userNameDisplay.textContent = data.user_name;
					}
				} catch (err) {
					addMessage('Gagal terhubung ke backend. Pastikan app.py sudah dijalankan.', 'bot');
				}
			}

			async function handleTrainingFlow(msg) {
				if (trainingState === 'trigger') {
					tempTrigger = msg;
					addMessage("Saya harus merespon apa untuk pemicu tersebut?", 'bot');
					trainingState = 'response';
				} else if (trainingState === 'response') {
					const tempResponse = msg;
					try {
						const res = await fetch('http://127.0.0.1:5000/train', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ trigger: tempTrigger, response: tempResponse })
						});
						const data = await res.json();
						
						if (data.success) {
							addMessage(`Berhasil! Mulai sekarang jika Anda mengetik "${tempTrigger}", saya akan menjawab: "${tempResponse}"`, 'bot');
						} else {
							addMessage('Maaf, saya gagal menyimpan pengetahuan tersebut: ' + data.message, 'bot');
						}
					} catch (err) {
						addMessage('Gagal terhubung ke backend untuk menyimpan latihan.', 'bot');
					}
					
					// Kembali ke mode chat normal
					currentMode = 'chat';
					trainingState = 'idle';
					btnNewChat.classList.add('active');
					addMessage("Mode Latihan selesai. Kembali ke mode chat normal.", 'system');
				}
			}
		</script>
	</body>
</html>
