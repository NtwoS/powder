		</div>

		<div id="toast-container-global"></div>



		<script>
			const form = document.getElementById('chat-form');
			const input = document.getElementById('user-input');
			const container = document.getElementById('chat-container');
			const status = document.getElementById('connection-status');
			const userNameDisplay = document.getElementById('display-user-name');
			
			// Sidebar Buttons
			const btnSkills = document.getElementById('btn-skills');
			const btnNewChat = document.getElementById('btn-new-chat');
			const btnAdminPanel = document.getElementById('btn-admin-panel');
			const btnSettings = document.getElementById('btn-settings');

			// Views
			const viewChat = document.getElementById('view-chat');
			const viewSkills = document.getElementById('view-skills');
			const viewAdmin = document.getElementById('view-admin');
			const viewSettings = document.getElementById('view-settings');

			// State Machine for Training Mode
			let currentMode = 'chat'; // 'chat' or 'train'
			let trainingState = 'idle'; // 'idle', 'trigger', 'response'
			let tempTrigger = '';
			let currentConversationId = null; // ID percakapan aktif

			function showView(viewName) {
				const views = {
					'chat': viewChat,
					'skills': viewSkills,
					'admin': viewAdmin,
					'settings': viewSettings
				};
				const navs = {
					'chat': btnNewChat,
					'skills': btnSkills,
					'admin': btnAdminPanel,
					'settings': btnSettings
				};

				// Sembunyikan semua view dan hapus class active di semua tombol
				Object.values(views).forEach(v => { if(v) v.style.display = 'none'; });
				Object.values(navs).forEach(n => { if(n) n.classList.remove('active'); });

				// Tampilkan view yang dipilih dan aktifkan tombolnya
				if (views[viewName]) {
					views[viewName].style.display = 'flex';
				}
				if (navs[viewName]) {
					navs[viewName].classList.add('active');
				}

				if (viewName === 'admin') fetchIntents();
				if (viewName === 'settings') fetchSettings();
			}

			// Sidebar Navigation Listeners
			btnNewChat.addEventListener('click', () => {
				currentMode = 'chat';
				trainingState = 'idle';
				currentConversationId = null; // Reset — conversation baru akan dibuat saat pesan pertama
				container.innerHTML = '';
				document.getElementById('empty-state').style.display = 'flex';
				showView('chat');
				// Hapus highlight aktif dari sidebar history
				document.querySelectorAll('.conv-item').forEach(el => el.classList.remove('conv-active'));
			});
			btnSkills.addEventListener('click', () => showView('skills'));
			btnAdminPanel.addEventListener('click', () => showView('admin'));
			btnSettings.addEventListener('click', () => showView('settings'));

			// Skills Card Actions
			document.getElementById('card-skill-latihan').addEventListener('click', () => {
				showView('chat');
				currentMode = 'train';
				trainingState = 'trigger';
				addMessage("Mode Latihan Aktif. Apa pertanyaan atau pemicu yang ingin Anda ajarkan?", 'bot');
			});

			document.getElementById('card-skill-finance').addEventListener('click', () => {
				showView('chat');
				addMessage("Mode Keuangan Aktif. Silakan sebutkan pengeluaran atau pemasukan Anda (Contoh: 'beli kopi 20rb' atau 'gaji masuk 5jt').", 'bot');
			});

			// Settings Logic
			async function fetchSettings() {
				try {
					const res = await fetch('http://127.0.0.1:5050/settings');
					const data = await res.json();
					
					// Populate Inputs
					document.getElementById('input-gemini-key').value = data.gemini_api_key || '';
					document.getElementById('input-ollama-url').value = data.ollama_api_url || 'http://localhost:11434';
					document.getElementById('input-ollama-path').value = data.ollama_models_path || '';
					document.getElementById('input-history-days').value = data.history_days || '7';
					
					// Set Active Brain Badge
					const brainBadge = document.getElementById('current-brain-badge');
					if (data.fallback_brain === 'gemini') {
						brainBadge.textContent = 'Gemini';
						document.querySelector('[data-brain="gemini"]').classList.add('active');
						document.querySelector('[data-brain="ollama"]').classList.remove('active');
						document.getElementById('settings-gemini').style.display = 'block';
						document.getElementById('settings-ollama').style.display = 'none';
					} else {
						brainBadge.textContent = 'Ollama';
						document.querySelector('[data-brain="ollama"]').classList.add('active');
						document.querySelector('[data-brain="gemini"]').classList.remove('active');
						document.getElementById('settings-ollama').style.display = 'block';
						document.getElementById('settings-gemini').style.display = 'none';
					}

					// Set Active Ollama Model in Dropdown (Dynamically selected)
					// Model dropdown diisi oleh fetchOllamaModels(), bukan di sini
