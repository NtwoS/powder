			// Admin Logic
			let allIntents = [];
			const adminSearch = document.getElementById('admin-search');

			// Run Ollama Model in CMD
			document.getElementById('btn-run-ollama').addEventListener('click', async () => {
				let modelName = selectLearnModel.value;
				if (modelName === 'custom') {
					modelName = inputLearnCustomModel.value.trim();
					if (!modelName) {
						alert("Silakan masukkan nama model custom.");
