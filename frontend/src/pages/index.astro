			function showToast(title, message, itemData = null) {
				if (!notificationsEnabled) return;
				
				const container = document.getElementById('toast-container-global');
				const toast = document.createElement('div');
				toast.className = 'toast';
				toast.innerHTML = `
					<div class="toast-header">
						<span>✨</span>
						<span>${title}</span>
					</div>
					<div class="toast-body">${message}</div>
				`;
				
				container.appendChild(toast);

				// Update history panel
				if (itemData) {
					if (learnedItemsCache.size === 1) listHistory.innerHTML = ''; // Clear empty msg
					const historyItem = document.createElement('div');
					historyItem.className = 'history-item';
					historyItem.innerHTML = `
						<strong>Pola Baru Terdeteksi</strong>
						<p>${itemData.tanya}</p>
						<div style="font-size: 0.75rem; color: #555; margin-top: 8px;">Respon: ${itemData.jawab.substring(0, 60)}...</div>
					`;
					listHistory.insertBefore(historyItem, listHistory.firstChild);

					newItemsCount++;
					badgeHistory.textContent = newItemsCount;
					badgeHistory.style.display = 'block';
				}
				
				// Auto remove
				setTimeout(() => {
					toast.classList.add('fade-out');
					setTimeout(() => toast.remove(), 400);
				}, 4000);
			}

			const checkInfinite = document.getElementById('check-infinite');
			const durationWrapper = document.getElementById('duration-input-wrapper');

			if (checkInfinite) {
