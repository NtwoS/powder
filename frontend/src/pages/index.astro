			async function updateAutolearnStatus() {
				try {
					const res = await fetch('http://127.0.0.1:5050/auto_learning/status');
					const data = await res.json();
					
					const reportDiv = document.getElementById('autolearn-report');
					const reportList = document.getElementById('autolearn-report-list');
					
					if (data.is_learning) {
						btnStartLearn.style.display = 'none';
						btnStopLearn.style.display = 'block';
						statusText.style.display = 'block';
						badgeAutolearn.textContent = "Berjalan";
						badgeAutolearn.style.background = "#10b981";
						
						if (data.time_remaining === "Infinite") {
							statusText.innerHTML = '<span class="pulse" style="display: inline-block; width: 10px; height: 10px; background: #10b981; border-radius: 50%; margin-right: 10px;"></span>Sedang Berlatih... Mode Tanpa Batas';
						} else {
							statusText.innerHTML = `<span class="pulse" style="display: inline-block; width: 10px; height: 10px; background: #10b981; border-radius: 50%; margin-right: 10px;"></span>Sedang Berlatih... Sisa Waktu: ${data.time_remaining}`;
						}
						
						if (!autolearnInterval) {
							autolearnInterval = setInterval(updateAutolearnStatus, 2000);
						}
					} else {
						btnStartLearn.style.display = 'block';
						btnStopLearn.style.display = 'none';
						statusText.style.display = 'none';
						badgeAutolearn.textContent = "Mati";
						badgeAutolearn.style.background = "#64748b";
						if (autolearnInterval) {
							clearInterval(autolearnInterval);
							autolearnInterval = null;
						}
					}

					// Update Report
					if (data.learned_items && data.learned_items.length > 0) {
						reportDiv.style.display = 'block';
						reportList.innerHTML = data.learned_items.map(item => 
							`<li style="margin-bottom: 10px; padding-bottom: 5px; border-bottom: 1px solid rgba(255,255,255,0.05);">
								<strong>Q:</strong> ${item.tanya} <br> 
								<span style="font-size:0.85rem; color:#818cf8;">A: ${item.jawab}</span>
							</li>`
						).reverse().join('');

						// Show notifications for NEW items
						data.learned_items.forEach(item => {
							if (!learnedItemsCache.has(item.tanya)) {
								learnedItemsCache.add(item.tanya);
								showToast("Diana Sedang Belajar", `Menyerap ilmu: <strong>${item.tanya}</strong>`, item);
							}
						});
					}
				} catch (e) { console.error(e); }
			}

			btnStartLearn.addEventListener('click', async () => {
