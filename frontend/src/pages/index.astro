						fetchOllamaModels(); // Segarkan daftar model
					} else {
						alert("Gagal: " + data.message);
					}
				} catch (e) {
					alert("Terjadi kesalahan saat menghubungkan otak cadangan.");
				} finally {
					btnSyncOllama.innerHTML = `
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
						Hubungkan
					`;
					btnSyncOllama.disabled = false;
				}
			});
			
			async function fetchOllamaModels() {
				try {
					const res = await fetch('http://127.0.0.1:5050/ollama/models');
					const data = await res.json();
					if (data.models && data.models.length > 0) {
						// Ambil model yang sedang aktif dari server
						const statusRes = await fetch('http://127.0.0.1:5050/status');
						const statusData = await statusRes.json();
						const activeModel = statusData.settings?.ollama_model || window._savedOllamaModel || data.models[0];

						const optionsHtml = data.models.map(m => 
							`<option value="${m}" ${m === activeModel ? 'selected' : ''}>${m}</option>`
						).join('');
						
						// Update dropdown Latihan Mandiri
						const currentLearnVal = selectLearnModel.value;
						selectLearnModel.innerHTML = optionsHtml + '<option value="custom">-- Gunakan Model Custom --</option>';
						if (data.models.includes(currentLearnVal)) selectLearnModel.value = currentLearnVal;

						// Update dropdown Otak Cadangan
						if (selectDefaultOllama) {
							selectDefaultOllama.innerHTML = optionsHtml;
						}

						// Update label model di chat footer
						const activeModelLabel = document.getElementById('active-model-label');
						if (activeModelLabel) {
							activeModelLabel.textContent = activeModel || data.models[0];
						}
					} else {
						const noModelMsg = '<option value="">Tidak ada model terdeteksi</option><option value="custom">-- Gunakan Model Custom --</option>';
						selectLearnModel.innerHTML = noModelMsg;
						if (selectDefaultOllama) selectDefaultOllama.innerHTML = noModelMsg;
						// Update label
						const activeModelLabel = document.getElementById('active-model-label');
						if (activeModelLabel) activeModelLabel.textContent = 'Tidak ada model';
					}
				} catch (e) { console.error("Gagal mengambil daftar model Ollama:", e); }
			}

